# ─── Model weights & training checkpoints (multi-GB; GitHub blocks files >100 MB) ──
# Each runs/ SUBdirectory is a checkpoint (merged weights, LoRA adapters, optimizer
# state).
runs/*/

# ─── Run outputs: logs + result JSONs are regenerated by the scripts, not committed ─────
# Figures (runs/*.png) are kept. Exceptions: the three corrected Milestone 2 curves, so
# scripts/plot_results.py can redraw fig_reattack.png and the headline numbers can be
# checked without a GPU. (Files committed before this rule — the Milestone 1 eval_*.json
# and the superseded pre-fix curves — stay tracked; git ignores only untracked files.)
runs/*.log
runs/*.json
!runs/reattack_original_fixed.json
!runs/reattack_restored_balanced_2ep_fixed.json
!runs/reattack_restored_ownorder_fixed.json

# Belt-and-suspenders: never commit large weight formats, wherever they land.
*.safetensors
*.bin
*.ckpt
*.gguf
*.pth
# (artifacts/*.pt are tiny extracted refusal directions — intentionally kept.)

# ─── Python ────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ─── Virtualenv / editor / OS ────────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.vscode/
.idea/
*.swp
.DS_Store

# ─── Misc caches (in case HF_HOME / wandb ever point inside the repo) ────────────────
.cache/
huggingface/
wandb/
